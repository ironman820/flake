{
  flake.nixosModules.kcc =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      inherit (config.ironman) kcc;
      inherit (lib)
        mkEnableOption
        mkIf
        mkOption
        ;
      inherit (lib.types) bool str;
    in
    {
      options.ironman.kcc = {
        enable = mkEnableOption "Enable the KCC server";
        domain = mkOption {
          default = "kcc.home";
          description = "Domain to access KCC from";
          type = str;
        };
        ip = mkOption {
          default = "";
          description = "KCC IP";
          type = str;
        };
        private = mkOption {
          default = true;
          description = "Is the service only available on the local network?";
          type = bool;
        };
      };
      config = {
        # Runtime
        virtualisation = mkIf kcc.enable {
          docker.autoPrune.enable = true;
          oci-containers = {
            backend = "docker";
            # Containers
            containers."kcc-cloud" = {
              image = "nilsleo/kcc-cloud:latest";
              environment = {
                "CELERY_WORKERS" = "4";
                "GROUP_ID" = "1000";
                "NEXT_PUBLIC_MAX_FILES" = "10";
                "TZ" = "America/Chicago";
                "USER_ID" = "1000";
              };
              volumes = [
                "/home/ironman/kcc-web-data:/data:rw"
              ];
              ports = [
                "8654:80/tcp"
              ];
              log-driver = "journald";
              extraOptions = [
                "--network-alias=kcc-cloud"
                "--network=kcc_default"
              ];
            };
          };
        };

        services.traefik.dynamicConfigOptions.http = {
          routers.kcc = {
            entryPoints = "https";
            middlewares = if kcc.private then "secured" else "default-headers";
            rule = "Host(`${kcc.domain}.niceastman.com`)";
            service = "kcc";
            tls = { };
          };
          services.kcc.loadBalancer = {
            passHostHeader = true;
            servers = [
              {
                url = "http://${kcc.ip}:8654";
              }
            ];
            serversTransport = "insecure";
          };
        };
        systemd = mkIf kcc.enable {
          services = {
            "docker-kcc-cloud" = {
              serviceConfig = {
                Restart = lib.mkOverride 90 "always";
                RestartMaxDelaySec = lib.mkOverride 90 "1m";
                RestartSec = lib.mkOverride 90 "100ms";
                RestartSteps = lib.mkOverride 90 9;
              };
              unitConfig.Description = "Container kcc-cloud generated by compose2nix.";
              after = [
                "docker-network-kcc_default.service"
              ];
              requires = [
                "docker-network-kcc_default.service"
              ];
              partOf = [
                "docker-compose-kcc-root.target"
              ];
              wantedBy = [
                "docker-compose-kcc-root.target"
              ];
            };

            # Networks
            "docker-network-kcc_default" = {
              unitConfig.Description = "Network kcc_default generated by compose2nix.";
              path = [ pkgs.docker ];
              serviceConfig = {
                Type = "oneshot";
                RemainAfterExit = true;
                ExecStop = "docker network rm -f kcc_default";
              };
              script = ''
                docker network inspect kcc_default || docker network create kcc_default
              '';
              partOf = [ "docker-compose-kcc-root.target" ];
              wantedBy = [ "docker-compose-kcc-root.target" ];
            };
          };

          # Root service
          # When started, this will automatically create all resources and start
          # the containers. When stopped, this will teardown all resources.
          targets."docker-compose-kcc-root" = {
            unitConfig = {
              Description = "Root target generated by compose2nix.";
            };
            wantedBy = [ "multi-user.target" ];
          };
        };
      };
    };
}
