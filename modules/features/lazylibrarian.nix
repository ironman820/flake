{
  flake = {
    nixosModules.lazylibrarian =
      { config, lib, pkgs, ... }:
      let
        inherit (lib)
          mkEnableOption
          mkIf
          mkOption
          types
          ;
        inherit (types) nullOr string;
        cfg = config.ironman;
        llb = cfg.lazylibrarian;
      in
      {
        options.ironman.lazylibrarian = {
          enable = mkEnableOption "Enable lazylibrarian install";
          ip = mkOption {
            default = null;
            description = "IP address of the lazylibrarian server";
            type = nullOr string;
          };
        };
        config = {
          services.traefik.dynamicConfigOptions.http = {
            routers.lazylibrarian = {
              entryPoints = "https";
              middlewares = "secured";
              rule = "Host(`library.home.niceastman.com`)";
              service = "lazylibrarian";
              tls = { };
            };
            services.lazylibrarian.loadBalancer = {
              passHostHeader = true;
              servers = [
                {
                  url = "http://${llb.ip}:5299";
                }
              ];
              serversTransport = "insecure";
            };
          };
          systemd = mkIf llb.enable {
            services = {
              "docker-lazylibrarian" = {
                serviceConfig = {
                  Restart = lib.mkOverride 90 "always";
                  RestartMaxDelaySec = lib.mkOverride 90 "1m";
                  RestartSec = lib.mkOverride 90 "100ms";
                  RestartSteps = lib.mkOverride 90 9;
                };
                after = [
                  "docker-network-lazylibrarian_default.service"
                ];
                requires = [
                  "docker-network-lazylibrarian_default.service"
                ];
                partOf = [
                  "docker-compose-lazylibrarian-root.target"
                ];
                wantedBy = [
                  "docker-compose-lazylibrarian-root.target"
                ];
              };
              "docker-network-lazylibrarian_default" = {
                path = [ pkgs.docker ];
                serviceConfig = {
                  Type = "oneshot";
                  RemainAfterExit = true;
                  ExecStop = "docker network rm -f lazylibrarian_default";
                };
                script = ''
                  docker network inspect lazylibrarian_default || docker network create lazylibrarian_default
                '';
                partOf = [ "docker-compose-lazylibrarian-root.target" ];
                wantedBy = [ "docker-compose-lazylibrarian-root.target" ];
              };
            };
            targets."docker-compose-lazylibrarian-root" = {
              unitConfig = {
                Description = "Root target generated by compose2nix.";
              };
              wantedBy = [ "multi-user.target" ];
            };
          };
          virtualisation = mkIf llb.enable {
            docker.autoPrune.enable = true;
            oci-containers = {
              backend = "docker";
              containers."lazylibrarian" = {
                image = "lscr.io/linuxserver/lazylibrarian:latest";
                environment = {
                  "DOCKER_MODS" = "linuxserver/mods:universal-calibre|linuxserver/mods:lazylibrarian-ffmpeg";
                  "PGID" = "1000";
                  "PUID" = "1000";
                  "TZ" = "America/Chicago";
                };
                volumes = [
                  "/data/books:/books:rw"
                  "/data/downloads/books:/downloads:rw"
                  "/data/docker/lazylibrarian:/config:rw"
                ];
                ports = [
                  "5299:5299/tcp"
                ];
                log-driver = "journald";
                extraOptions = [
                  "--network-alias=lazylibrarian"
                  "--network=lazylibrarian_default"
                ];
              };
            };
          };
        };
      };
  };
}
