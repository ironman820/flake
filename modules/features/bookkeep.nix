{
  flake.nixosModules.bookkeep =
      {
        config,
        lib,
        pkgs,
        ...
      }:
      let
        inherit (lib)
          mkEnableOption
          mkIf
          mkOption
          types
          ;
        inherit (types) nullOr str;
        cfg = config.ironman;
        bkp = cfg.bookkeep;
      in
      {
        options.ironman.bookkeep = {
          enable = mkEnableOption "Enable bookkeep install";
          ip = mkOption {
            default = null;
            description = "IP address of the bookkeep server";
            type = nullOr str;
          };
        };
        config = {
          services.traefik.dynamicConfigOptions.http = {
            routers.bookkeep = {
              entryPoints = "https";
              middlewares = "secured";
              rule = "Host(`library.home.niceastman.com`)";
              service = "bookkeep";
              tls = { };
            };
            services.bookkeep.loadBalancer = {
              passHostHeader = true;
              servers = [
                {
                  url = "http://${bkp.ip}:8000";
                }
              ];
              serversTransport = "insecure";
            };
          };
          systemd = mkIf bkp.enable {
            services = {
              "docker-bookkeep" = {
                serviceConfig = {
                  Restart = lib.mkOverride 90 "always";
                  RestartMaxDelaySec = lib.mkOverride 90 "1m";
                  RestartSec = lib.mkOverride 90 "100ms";
                  RestartSteps = lib.mkOverride 90 9;
                };
                after = [
                  "docker-network-bookkeep_default.service"
                ];
                requires = [
                  "docker-network-bookkeep_default.service"
                ];
                partOf = [
                  "docker-compose-bookkeep-root.target"
                ];
                wantedBy = [
                  "docker-compose-bookkeep-root.target"
                ];
              };
              "docker-network-bookkeep_default" = {
                path = [ pkgs.docker ];
                serviceConfig = {
                  Type = "oneshot";
                  RemainAfterExit = true;
                  ExecStop = "docker network rm -f bookkeep_default";
                };
                script = ''
                  docker network inspect bookkeep_default || docker network create bookkeep_default
                '';
                partOf = [ "docker-compose-bookkeep-root.target" ];
                wantedBy = [ "docker-compose-bookkeep-root.target" ];
              };
            };
            targets."docker-compose-bookkeep-root" = {
              unitConfig = {
                Description = "Root target generated by compose2nix.";
              };
              wantedBy = [ "multi-user.target" ];
            };
          };
          virtualisation = mkIf bkp.enable {
            docker.autoPrune.enable = true;
            oci-containers = {
              backend = "docker";
              containers."bookkeep" = {
                image = "akiraslingshot/bookkeep:latest";
                environmentFiles = [
                  config.sops.secrets.bookkeep_env.path
                ];
                volumes = [
                  "/data/downloads/books:/downloads:rw"
                ];
                ports = [
                  "8000:8000/tcp"
                ];
                log-driver = "journald";
                extraOptions = [
                  "--network-alias=app"
                  "--network=bookkeep_default"
                ];
              };
            };
          };
        };
      };
}
