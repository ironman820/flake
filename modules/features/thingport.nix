{
  self,
  ...
}:
{
  flake = {
    nixosModules.thingport =
      {
        config,
        lib,
        pkgs,
        ...
      }:
      let
        inherit (lib) mkOption;
        inherit (lib.types) nullOr str;
        cfg = config.ironman.thingport;
      in
      {
        imports = with self.nixosModules; [
          docker
        ];
        options.ironman.thingport =
          {
            envFile = mkOption {
              default = null;
              description = "Location of an envFile for the containers";
              type = nullOr str;
            };
            flaresolverrIP = mkOption {
              default = "";
              description = "IP of the flaresolverr server";
              type = str;
            };
            version = mkOption {
              default = "1";
              description = "Version of the backend to install";
              type = str;
            };
          };
        config = {
          ironman.postgres = {
            enable = true;
            dbName = "thingport";
            external.enable = true;
          };
          systemd = {
            services = {
              # Containers
              "docker-thingport-backend" = {
                serviceConfig = {
                  Restart = lib.mkOverride 90 "always";
                  RestartMaxDelaySec = lib.mkOverride 90 "1m";
                  RestartSec = lib.mkOverride 90 "100ms";
                  RestartSteps = lib.mkOverride 90 9;
                };
                unitConfig.Description = "Container thingport-backend generated by compose2nix.";
                after = [
                  "docker-network-thingport_app-net.service"
                ];
                requires = [
                  "docker-network-thingport_app-net.service"
                ];
                partOf = [
                  "docker-compose-thingport-root.target"
                ];
                wantedBy = [
                  "docker-compose-thingport-root.target"
                ];
              };
              "docker-thingport-frontend" = {
                serviceConfig = {
                  Restart = lib.mkOverride 90 "always";
                  RestartMaxDelaySec = lib.mkOverride 90 "1m";
                  RestartSec = lib.mkOverride 90 "100ms";
                  RestartSteps = lib.mkOverride 90 9;
                };
                unitConfig.Description = "Container thingport-frontend generated by compose2nix.";
                after = [
                  "docker-network-thingport_app-net.service"
                ];
                requires = [
                  "docker-network-thingport_app-net.service"
                ];
                partOf = [
                  "docker-compose-thingport-root.target"
                ];
                wantedBy = [
                  "docker-compose-thingport-root.target"
                ];
              };

              # Networks
              "docker-network-thingport_app-net" = {
                unitConfig.Description = "Network thingport_app-net generated by compose2nix.";
                path = [ pkgs.docker ];
                serviceConfig = {
                  Type = "oneshot";
                  RemainAfterExit = true;
                  ExecStop = "docker network rm -f thingport_app-net";
                };
                script = ''
                  docker network inspect thingport_app-net || docker network create thingport_app-net --driver=bridge
                '';
                partOf = [ "docker-compose-thingport-root.target" ];
                wantedBy = [ "docker-compose-thingport-root.target" ];
              };
              postgresql.after = [ "sops-nix.service" ];
            };
            targets."docker-compose-thingport-root" = {
              unitConfig = {
                Description = "Root target generated by compose2nix.";
              };
              wantedBy = [ "multi-user.target" ];
            };
          };
          virtualisation = {
            docker.autoPrune.enable = true;
            oci-containers = {
              backend = "docker";
              containers = {
                "thingport-backend" = {
                  image = "ghcr.io/tautvydasderzinskas/thingport-backend:${cfg.version}";
                  environment = {
                    # Commented Environment variables have been moved to the env file
                    # "AUTH_SECRET" = "changeme-secret";
                    # "DATABASE_URL" = "postgresql://thingport:thingport@db:5432/thingport?schema=public";
                    # "SMTP_HOST" = "";
                    # "SMTP_PASS" = "";
                    # "SMTP_USER" = "";
                    "AUTH_TOKEN_TTL" = "43200";
                    "CORS_ORIGINS" = "";
                    "FILE_STORAGE" = "/app/storage";
                    "FLARESOLVERR_REQUIRE_HTTPS" = "false";
                    "FLARESOLVERR_URL" = "http://${cfg.flaresolverrIP}:8191/v1";
                    "PGID" = "1000";
                    "PUBLIC_URL" = "https://${cfg.domain}.niceastman.com";
                    "PUID" = "1000";
                    "SMTP_FROM" = "Thingport <no-reply@niceastman.com>";
                    "SMTP_PORT" = "465";
                    "SMTP_SECURE" = "true";
                  };
                  environmentFiles = [
                    cfg.envFile
                  ];
                  volumes = [
                    "/data/3dmodels:/app/storage:rw"
                  ];
                  log-driver = "journald";
                  extraOptions = [
                    "--network-alias=backend"
                    "--network=thingport_app-net"
                  ];
                };
                "thingport-frontend" = {
                  image = "ghcr.io/tautvydasderzinskas/thingport-frontend:${cfg.version}";
                  ports = [
                    "${cfg.port}:80/tcp"
                  ];
                  dependsOn = [
                    "thingport-backend"
                  ];
                  log-driver = "journald";
                  extraOptions = [
                    "--network-alias=frontend"
                    "--network=thingport_app-net"
                  ];
                };
              };
            };
          };
        };
      };
  };
}
