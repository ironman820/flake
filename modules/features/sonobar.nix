{ self, ... }:
{
  flake.nixosModules.sonobar =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      inherit (lib)
        mkEnableOption
        mkIf
        mkOption
        types
        ;
      cfg = config.ironman;
      sono = cfg.sonobarr;
    in
    {
      options.ironman.sonobarr = {
        enable = mkEnableOption "Enable Sonobarr services";
        ip = mkOption {
          default = "";
          description = "Droppedneedle IP";
          type = types.str;
        };
      };
      config = {
        virtualisation = mkIf sono.enable {
          docker = {
            enable = true;
            autoPrune.enable = true;
          };
          oci-containers = {
            backend = "docker";
            containers."sonobarr" = {
              image = "ghcr.io/dodelidoo-labs/sonobarr:latest";
              environmentFiles = [
                config.sops.secrets.sonobarr_env.path
              ];
              volumes = [
                "/etc/localtime:/etc/localtime:ro"
                "/data/docker/sonobarr:/sonobarr/config:rw"
              ];
              ports = [
                "5000:5000/tcp"
              ];
              log-driver = "journald";
              extraOptions = [
                "--network-alias=sonobarr"
                "--network=sonobar_default"
              ];
            };
          };
        };
        services.traefik.dynamicConfigOptions.http = {
          routers.droppedneedle = {
            entryPoints = "https";
            middlewares = "secured";
            rule = "Host(`sonobarr.home.niceastman.com`)";
            service = "sonobarr";
            tls = { };
          };
          services.sonobarr.loadBalancer = {
            passHostHeader = true;
            servers = [
              {
                url = "http://${cfg.ip}:5000";
              }
            ];
            serversTransport = "insecure";
          };
        };
        sops.secrets.sonobarr_env = {
          sopsFile = "${self.outPath}/.secrets/sonobarr.yaml";
          owner = cfg.user.name;
          group = cfg.user.name;
        };
        systemd = mkIf sono.enable {
          services = {
            "docker-sonobarr" = {
              serviceConfig = {
                Restart = lib.mkOverride 90 "always";
                RestartMaxDelaySec = lib.mkOverride 90 "1m";
                RestartSec = lib.mkOverride 90 "100ms";
                RestartSteps = lib.mkOverride 90 9;
              };
              unitConfig.Description = "Container sonobarr generated by compose2nix.";
              after = [
                "docker-network-sonobar_default.service"
              ];
              requires = [
                "docker-network-sonobar_default.service"
              ];
              partOf = [
                "docker-compose-sonobar-root.target"
              ];
              wantedBy = [
                "docker-compose-sonobar-root.target"
              ];
            };

            # Networks
            "docker-network-sonobar_default" = {
              unitConfig.Description = "Network sonobar_default generated by compose2nix.";
              path = [ pkgs.docker ];
              serviceConfig = {
                Type = "oneshot";
                RemainAfterExit = true;
                ExecStop = "docker network rm -f sonobar_default";
              };
              script = ''
                docker network inspect sonobar_default || docker network create sonobar_default
              '';
              partOf = [ "docker-compose-sonobar-root.target" ];
              wantedBy = [ "docker-compose-sonobar-root.target" ];
            };
          };

          # Root service
          # When started, this will automatically create all resources and start
          # the containers. When stopped, this will teardown all resources.
          targets."docker-compose-sonobar-root" = {
            unitConfig = {
              Description = "Root target generated by compose2nix.";
            };
            wantedBy = [ "multi-user.target" ];
          };
        };
      };
    };
}
