{
  flake.nixosModules.kcc =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      inherit (config.ironman) kcc;
      inherit (lib)
        mkEnableOption
        mkIf
        mkOption
        ;
      inherit (lib.types) bool str;
    in
    {
      options.ironman.kcc = {
        enable = mkEnableOption "Enable the KCC server";
        domain = mkOption {
          default = "kcc.home";
          description = "Domain to access KCC from";
          type = str;
        };
        ip = mkOption {
          default = "";
          description = "KCC IP";
          type = str;
        };
        private = mkOption {
          default = true;
          description = "Is the service only available on the local network?";
          type = bool;
        };
      };
      config = {
        # Runtime
        virtualisation = mkIf kcc.enable {
          podman = {
            enable = true;
            autoPrune.enable = true;
            dockerCompat = true;
          };
          oci-containers = {
            backend = "podman";
            # Containers
            containers."kcc-cloud" = {
              image = "nilsleo/kcc-cloud:latest";
              environment = {
                "CELERY_WORKERS" = "4";
                "GROUP_ID" = "1000";
                "NEXT_PUBLIC_MAX_FILES" = "10";
                "TZ" = "America/Chicago";
                "USER_ID" = "1000";
              };
              volumes = [
                "/home/ironman/kcc-web-data:/data:rw"
              ];
              ports = [
                "8654:8654/tcp"
              ];
              log-driver = "journald";
              extraOptions = [
                "--network-alias=kcc-cloud"
                "--network=kcc_default"
              ];
            };
          };
        };

        services.traefik.dynamicConfigOptions.http = {
          routers.kcc = {
            entryPoints = "https";
            middlewares = if kcc.private then "secured" else "default-headers";
            rule = "Host(`${kcc.domain}.niceastman.com`)";
            service = "kcc";
            tls = { };
          };
          services.kcc.loadBalancer = {
            passHostHeader = true;
            servers = [
              {
                url = "http://${kcc.ip}:8654";
              }
            ];
            serversTransport = "insecure";
          };
        };
        systemd = mkIf kcc.enable {
          services = {
            "podman-kcc-cloud" = {
              serviceConfig = {
                Restart = lib.mkOverride 90 "always";
              };
              after = [
                "podman-network-kcc_default.service"
              ];
              requires = [
                "podman-network-kcc_default.service"
              ];
              partOf = [
                "podman-compose-kcc-root.target"
              ];
              wantedBy = [
                "podman-compose-kcc-root.target"
              ];
            };

            # Networks
            "podman-network-kcc_default" = {
              path = [ pkgs.podman ];
              serviceConfig = {
                Type = "oneshot";
                RemainAfterExit = true;
                ExecStop = "podman network rm -f kcc_default";
              };
              script = ''
                podman network inspect kcc_default || podman network create kcc_default
              '';
              partOf = [ "podman-compose-kcc-root.target" ];
              wantedBy = [ "podman-compose-kcc-root.target" ];
            };
          };

          # Root service
          # When started, this will automatically create all resources and start
          # the containers. When stopped, this will teardown all resources.
          targets."podman-compose-kcc-root" = {
            unitConfig = {
              Description = "Root target generated by compose2nix.";
            };
            wantedBy = [ "multi-user.target" ];
          };
        };
      };
    };
}
